{
  "autonomy": {
    "act_on_connections": "deny",
    "delegate_synthetic": "allow",
    "deploy": "allow",
    "merge_pull_requests": "allow",
    "observe": "allow",
    "open_pull_requests": "allow",
    "provision_dependencies": "allow",
    "rollback": "allow",
    "run_experiments": "allow",
    "use_new_capabilities": "allow"
  },
  "business_constraints": {
    "destructive_operations": "deny",
    "maximum_monthly_spend_usd": 5.0
  },
  "connections": [
    {
      "content_may_leave": true,
      "credential_ref": "SPOOLMAN_READER_PW",
      "docs": null,
      "environment": "staging",
      "id": "spoolman-db",
      "kind": "postgres",
      "limits": {},
      "location": "127.0.0.1:19013/spoolman",
      "permissions": [
        "read"
      ],
      "tls": "prefer",
      "username": "spoolman_reader"
    },
    {
      "content_may_leave": true,
      "credential_ref": null,
      "docs": "http://127.0.0.1:19012/api/v1/openapi.json",
      "environment": "staging",
      "id": "spoolman-api",
      "kind": "http_api",
      "limits": {},
      "location": "http://127.0.0.1:19012",
      "permissions": [
        "read"
      ],
      "tls": "prefer",
      "username": null
    }
  ],
  "egress": {
    "ci_environment": "auto",
    "github": {
      "base_branch": "master",
      "max_open_pull_requests": 3,
      "max_payload_bytes": 200000,
      "repository": "satisfymath/c13-spoolman",
      "token_env": "GITHUB_TOKEN"
    },
    "package_registries": [
      "pypi.org",
      "files.pythonhosted.org",
      "deb.debian.org",
      "registry.npmjs.org",
      "ghcr.io",
      "registry-1.docker.io",
      "github.com",
      "objects.githubusercontent.com"
    ],
    "remote_models": {
      "destinations": [
        "api.meta.ai"
      ],
      "max_payload_bytes": 20000,
      "max_tokens_per_call": 16000
    }
  },
  "evaluation": {
    "alpha": 0.01,
    "min_relative_effect": 0.2,
    "minimum_evidence_for_proposal": 4,
    "persistence_days": 7.0,
    "value_hours": {}
  },
  "goals": [],
  "models": {
    "local_fallback": "deny",
    "local_inference": "deny",
    "private_code_to_frontier": "allow",
    "profile": "frontier",
    "screenshots_to_frontier": "allow"
  },
  "operations": {
    "check_image": "python:3.12-slim",
    "check_steps": [
      [
        "python",
        "-c",
        "import compileall,sys; sys.exit(0 if compileall.compile_dir('.', quiet=1) else 1)"
      ]
    ],
    "deploy_steps": [
      [
        "docker",
        "compose",
        "-f",
        "docker-compose.yml",
        "-p",
        "c13-spoolman",
        "up",
        "-d",
        "--build"
      ]
    ],
    "guard_samples": 15,
    "health_url": null,
    "max_deploys_per_hour": 6,
    "max_merges_per_hour": 2,
    "probe_auth": null,
    "probe_every_s": 5.0,
    "self_host": "auto",
    "ui_capture_retention_days": 14.0
  },
  "priorities": [
    "correctness",
    "performance of reads as data grows",
    "robustness"
  ],
  "workspace": "spoolman"
}
